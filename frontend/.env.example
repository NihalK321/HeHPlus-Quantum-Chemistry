# Optional FastAPI base URL, including the API version prefix. Leave relative
# for a reverse-proxy deployment.
VITE_API_BASE_URL=/api/v1
# FastAPI target used only by Vite's development proxy. This is read when
# `npm run dev` starts; restart Vite after changing it.
VITE_PEPPERQ_BACKEND_URL=http://127.0.0.1:8000
# Existing FastAPI 0.2.0 peptide structure endpoint (separate from future v1 APIs).
VITE_STRUCTURE_API_BASE_URL=http://127.0.0.1:8000
